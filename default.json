{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Shared Renovate policy.",
  // Self-hosted in a Docker container
  "dependencyDashboard": false,
  "requireConfig": "ignored",
  "onboarding": false,
  // Consider a release stable after 3 days (same as Dependabot)
  "minimumReleaseAge": "3 days",
  "minimumReleaseAgeBehaviour": "timestamp-required",
  "internalChecksFilter": "strict",
  "ignoreUnstable": true,
  // Git settings
  "branchPrefix": "chore/",
  "prCreation": "not-pending",
  "packageRules": [
    {
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions",
      "groupSlug": "github-actions",
      "separateMajorMinor": false,
      "automerge": true,
      "automergeType": "pr",
      "automergeStrategy": "squash"
    },
    {
      "matchManagers": ["gitlabci"],
      "groupName": "GitLab CI",
      "groupSlug": "gitlab-ci",
      "separateMajorMinor": false,
      "automerge": true,
      "automergeType": "pr",
      "automergeStrategy": "squash"
    },
    {
      "matchManagers": ["gradle", "gradle-wrapper"],
      "groupName": "Gradle dependencies",
      "groupSlug": "gradle-dependencies",
      "allowedVersions": "/^\\d+(?:\\.\\d+)+(?:[.-](?:final|release|ga))?$/i"
    }
  ]
}
