{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Shared Renovate policy.",
  "extends": ["config:recommended"],

  // Dependency Dashboard
  "dependencyDashboard": true,

  // Scheduling
  "timezone": "Europe/Amsterdam",
  "schedule": ["before 9am on monday"],

  // Release stability
  "minimumReleaseAge": "3 days",
  "minimumReleaseAgeBehaviour": "timestamp-required",
  "internalChecksFilter": "strict",
  "ignoreUnstable": true,

  // Pull requests
  "labels": ["dependencies"],
  "prConcurrentLimit": 5,
  
  // Branches
  "branchPrefix": "renovate/",

  // Automerge defaults
  "automerge": false,
  "automergeType": "pr",
  "automergeStrategy": "squash",
  "platformAutomerge": true,
  "ignoreTests": false,

  "packageRules": [
    {
      "description": "Automerge stable non-major updates",
      "matchUpdateTypes": ["minor", "patch"],
      "matchCurrentVersion": "!/^0\\./",
      "automerge": true,
    },
    {
      "description": "Major updates require manual review",
      "matchUpdateTypes": ["major"],
      "automerge": false,
      "addLabels": ["major-update"],
    },
    {
      "description": "Group GitHub Actions updates",
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions",
      "groupSlug": "github-actions",
      "separateMajorMinor": true,
    },
    {
      "description": "Group GitLab CI updates",
      "matchManagers": ["gitlabci"],
      "groupName": "GitLab CI",
      "groupSlug": "gitlab-ci",
      "separateMajorMinor": true,
    },
    {
      "description": "Group Gradle dependencies",
      "matchManagers": ["gradle", "gradle-wrapper"],
      "groupName": "Gradle dependencies",
      "groupSlug": "gradle-dependencies",
      "separateMajorMinor": true,
    },
    {
      "description": "Copier template updates require manual review",
      "matchManagers": ["copier"],
      "automerge": false,
      "addLabels": ["template-update"]
    },
  ],
}
