{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "description": "Shared Renovate policy.",
  // Repository-safe policy only; global-only runtime options live in workflow/CI env.
  "dependencyDashboard": false,
  // Consider a release stable after 3 days (same as Dependabot)
  "minimumReleaseAge": "3 days",
  "minimumReleaseAgeBehaviour": "timestamp-required",
  "internalChecksFilter": "strict",
  "ignoreUnstable": true,
  // Git settings
  "branchPrefix": "renovate/",
  "prCreation": "immediate",
  "automerge": true,
  "automergeType": "pr",
  "automergeStrategy": "squash",
  "packageRules": [
    {
      "matchManagers": ["github-actions"],
      "groupName": "GitHub Actions",
      "groupSlug": "github-actions",
      "separateMajorMinor": false,
    },
    {
      "matchManagers": ["gitlabci"],
      "groupName": "GitLab CI",
      "groupSlug": "gitlab-ci",
      "separateMajorMinor": false,
    },
    {
      "matchManagers": ["gradle", "gradle-wrapper"],
      "groupName": "Gradle dependencies",
      "groupSlug": "gradle-dependencies",
      "allowedVersions": "/^\\d+(?:\\.\\d+)+(?:[.-](?:final|release|ga))?$/i",
    }
  ],
}
